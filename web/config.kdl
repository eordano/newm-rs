// The browser demo's session: newm-rs runs nested, as one Wayland window of the page, so Mod is
// Alt. Three terminals open on the canvas at start, the first in tmux.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    focus-follows-mouse
}

layout {
    gaps 12
    // Transparent, so the synth background behind the canvas shows; niri's default grey would
    // cover it.
    background-color "transparent"
    canvas {
        tile-width 560
        tile-height 360
        zoom-step 0.8
        zoom-min -2
        zoom-max 3
        default-width { proportion 0.5; }
        default-height { proportion 0.5; }
    }
}

// The guest has no X server of newm-rs's own to start.
xwayland-satellite {
    off
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path null

animations {
    // The guest draws with GL through the browser; short animations keep it responsive.
    slowdown 0.6
}

// waybar along the top; its layer-shell exclusive zone keeps the canvas below it.
spawn-at-startup "@bar@"
spawn-at-startup "@term@" "--title" "tmux" "--" "@tmux@"
spawn-at-startup "@term@" "--title" "terminal 1"
spawn-at-startup "@term@" "--title" "terminal 2"

binds {
    Mod+Return { spawn "@term@"; }
    Mod+T { spawn "@term@"; }
    // Alacritty, drawn with the GPU through the page's WebGL2 (the full session only).
    Mod+Shift+Return { spawn "@gpu-term@"; }
    Mod+Q { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Shift+Left  { send-to-edge "left"; }
    Mod+Shift+Right { send-to-edge "right"; }

    Mod+Equal { zoom-in; }
    Mod+Minus { zoom-out; }
    Mod+0     { zoom-reset; }
    Mod+WheelScrollUp   cooldown-ms=120 { zoom-in; }
    Mod+WheelScrollDown cooldown-ms=120 { zoom-out; }

    Mod+O { toggle-overview; }
    Mod+G { gather-islands; }
    Mod+Z { undo; }
    Mod+Shift+Z { redo; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
}

// The author's synthwave night behind the canvas: one still frame in the small session, animated
// (at most 30 moves a second, still after two idle minutes) in the full one.
synth-background {
    mode "@synth-mode@"
    max-fps 30
    idle-still-after 120
}
