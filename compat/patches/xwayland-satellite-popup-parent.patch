+    fn is_mapped_xdg_window(&self, window: x::Window) -> bool {
+        let Some(entity) = self.windows.get(&window).copied() else {
+            return false;
+        };
+        let Ok(mut query) = self
+            .world
+            .query_one::<(&WindowData, &SurfaceRole)>(entity)
+        else {
+            return false;
+        };
+        query
+            .get()
+            .is_some_and(|(data, role)| data.mapped && role.xdg().is_some())
+    }
+
+    /// A popup's parent by X geometry. `exact` asks for a toplevel with the popup's very rect (an
+    /// overlay tracking its window, which no menu or tooltip matches); otherwise any toplevel
+    /// holding the popup's origin, one of the same size first.
+    fn toplevel_under(&self, dims: WindowDims, exact: bool) -> Option<x::Window> {
+        let mut query = self
+            .world
+            .query::<(&x::Window, &WindowData, &SurfaceRole)>();
+        let mut best: Option<(bool, x::Window)> = None;
+        for (_, (window, data, role)) in query.iter() {
+            if !data.mapped || !matches!(role, SurfaceRole::Toplevel(Some(_))) {
+                continue;
+            }
+            let p = data.attrs.dims;
+            let same_rect = p == dims;
+            if exact {
+                if same_rect {
+                    return Some(*window);
+                }
+                continue;
+            }
+            let inside = dims.x >= p.x
+                && dims.y >= p.y
+                && (dims.x as i32) < p.x as i32 + p.width as i32
+                && (dims.y as i32) < p.y as i32 + p.height as i32;
+            if !inside {
+                continue;
+            }
+            let same_size = p.width == dims.width && p.height == dims.height;
+            if best.is_none_or(|(best_same, _)| same_size && !best_same) {
+                best = Some((same_size, *window));
+            }
+        }
+        best.map(|(_, window)| window)
+    }
