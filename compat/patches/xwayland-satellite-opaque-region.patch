+    /// Sets the window's `_NET_WM_OPAQUE_REGION`; the surface gets it with its next commit.
+    pub fn set_opaque_region(&mut self, window: x::Window, region: Option<Vec<[i32; 4]>>) {
+        let Some(id) = self.windows.get(&window).copied() else {
+            debug!("not setting opaque region for unknown window {window:?}");
+            return;
+        };
+        debug!("setting {window:?} opaque region {region:?}");
+        self.world
+            .get::<&mut WindowData>(id)
+            .unwrap()
+            .attrs
+            .opaque_region = region;
+    }
+
     pub fn set_win_class(&mut self, window: x::Window, class: String) {
         let Some(data) = self
             .windows
@@ -1721,3 +1741,52 @@ pub struct PendingSurfaceState {
     pub width: i32,
     pub height: i32,
 }
+
+/// The opaque rectangles of a window `width` x `height` pixels wide, at surface scale `scale`, in
+/// surface coordinates: each rectangle clipped to the window and shrunk to the whole surface units
+/// inside it, so the compositor never takes a pixel the client does not draw opaque for opaque.
+fn opaque_rects(rects: &[[i32; 4]], width: u16, height: u16, scale: f64) -> Vec<[i32; 4]> {
+    rects
+        .iter()
+        .filter_map(|&[x, y, w, h]| {
+            let (x0, y0) = (x.max(0), y.max(0));
+            let x1 = x.saturating_add(w).min(i32::from(width));
+            let y1 = y.saturating_add(h).min(i32::from(height));
+            let lx0 = (f64::from(x0) / scale).ceil() as i32;
+            let ly0 = (f64::from(y0) / scale).ceil() as i32;
+            let lx1 = (f64::from(x1) / scale).floor() as i32;
+            let ly1 = (f64::from(y1) / scale).floor() as i32;
+            (lx1 > lx0 && ly1 > ly0).then_some([lx0, ly0, lx1 - lx0, ly1 - ly0])
+        })
+        .collect()
+}
+
+/// Gives `surface` the window's opaque region when it, the window size or the scale changed
+/// since it was last given. Called before forwarding a commit, so the region applies with it.
+fn update_opaque_region(
+    win: &mut WindowData,
+    surface: &client::wl_surface::WlSurface,
+    scale: f64,
+    compositor: &client::wl_compositor::WlCompositor,
+    qh: &QueueHandle<MyWorld>,
+) {
+    let want = win.attrs.opaque_region.as_ref().map(|rects| {
+        let dims = &win.attrs.dims;
+        (rects.clone(), dims.width, dims.height, scale.to_bits())
+    });
+    if want == win.applied_opaque {
+        return;
+    }
+    match &want {
+        Some((rects, width, height, _)) => {
+            let region = compositor.create_region(qh, ());
+            for [x, y, w, h] in opaque_rects(rects, *width, *height, scale) {
+                region.add(x, y, w, h);
+            }
+            surface.set_opaque_region(Some(&region));
+            region.destroy();
+        }
+        None => surface.set_opaque_region(None),
+    }
+    win.applied_opaque = want;
+}
diff --git a/src/server/tests.rs b/src/server/tests.rs
index fa70c7d..879a143 100644
--- a/src/server/tests.rs
+++ b/src/server/tests.rs
@@ -1364,6 +1364,53 @@ fn window_title_and_class() {
     assert_eq!(data.toplevel().title, Some("superwindow".into()));
 }
 
+#[test]
+fn opaque_region_reaches_the_surface_with_a_commit() {
+    let (mut f, comp) = TestFixture::new_with_compositor();
+    let win = Window::new(1);
+    let (surface, id) = f.create_toplevel(&comp, win);
+
+    f.satellite
+        .set_opaque_region(win, Some(vec![[0, 0, 100, 100], [90, 90, 50, 50]]));
+    f.run();
+    let data = f.testwl.get_surface_data(id).unwrap();
+    assert_eq!(data.opaque_region, None, "it waits for the next commit");
+
+    surface.obj.commit();
+    f.run();
+    let data = f.testwl.get_surface_data(id).unwrap();
+    assert_eq!(
+        data.opaque_region,
+        Some(vec![[0, 0, 100, 100], [90, 90, 10, 10]]),
+        "clipped to the 100x100 window"
+    );
+
+    f.satellite.set_opaque_region(win, None);
+    surface.obj.commit();
+    f.run();
+    let data = f.testwl.get_surface_data(id).unwrap();
+    assert_eq!(data.opaque_region, None, "the property was deleted");
+}
+
+#[test]
+fn opaque_rects_shrink_to_whole_surface_units() {
+    use super::opaque_rects;
+    assert_eq!(
+        opaque_rects(&[[0, 0, 100, 100]], 100, 100, 1.0),
+        vec![[0, 0, 100, 100]]
+    );
+    assert_eq!(
+        opaque_rects(&[[1, 1, 1468, 1252]], 1470, 1254, 1.25),
+        vec![[1, 1, 1174, 1001]],
+        "inward at a fractional scale"
+    );
+    assert_eq!(
+        opaque_rects(&[[-10, -10, 30, 30], [200, 0, 10, 10]], 100, 100, 1.0),
+        vec![[0, 0, 20, 20]],
+        "clipped to the window; outside it, nothing"
+    );
+}
