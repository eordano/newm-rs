     }
 
+    /// `_NET_WM_OPAQUE_REGION`: rectangles (x, y, width, height) of the window, in its pixels,
+    /// that the client draws fully opaque.
+    fn get_opaque_region(&self, window: x::Window) -> XResult<Option<Vec<[i32; 4]>>> {
+        let cookie = self.get_property_cookie(
+            window,
+            self.atoms.net_wm_opaque_region,
+            x::ATOM_CARDINAL,
+            4 * 256,
+        );
+        let resolver = |reply: x::GetPropertyReply| {
+            let data: &[u32] = reply.value();
+            data.chunks_exact(4)
+                .map(|r| [r[0] as i32, r[1] as i32, r[2] as i32, r[3] as i32])
+                .collect::<Vec<_>>()
+        };
+        PropertyCookieWrapper::new(&self.connection, cookie).resolve(resolver)
+    }
+
     fn get_transient_for(&self, window: x::Window) -> XResult<Option<x::Window>> {
         let cookie =
             self.get_property_cookie(window, self.atoms.wm_transient_for, x::ATOM_WINDOW, 1);
@@ -837,6 +859,16 @@ impl XState {
         if self.handle_selection_property_change(&event) {
             return;
         }
+        if event.atom() == self.atoms.net_wm_opaque_region {
+            let window = event.window();
+            let region = if event.state() == x::Property::Delete {
+                None
+            } else {
+                unwrap_or_skip_bad_window_ret!(self.get_opaque_region(window))
+            };
+            server_state.set_opaque_region(window, region);
+            return;
+        }
         if event.state() == x::Property::Delete {
             debug!(
                 "ignoring delete for property {:?}",
@@ -923,6 +955,7 @@ xcb::atoms_struct! {
         primary => b"PRIMARY" only_if_exists = false,
         primary_targets => b"_primary_targets" only_if_exists = false,
         moveresize => b"_NET_WM_MOVERESIZE" only_if_exists = false,
+        net_wm_opaque_region => b"_NET_WM_OPAQUE_REGION" only_if_exists = false,
     }
 }
 
